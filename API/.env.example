# Copiar este archivo como .env y completar con valores reales.
# El .env NO se versiona (esta en .gitignore).

# Clave que la Pico manda en el encabezado X-Redux-Key.
REDUX_API_KEY=cambiar-esta-clave

# Clave de sesiones de Flask (cualquier cadena larga y aleatoria).
SECRET_KEY=cambiar-esta-clave-secreta

# Dejar en 0 en produccion. Poner 1 solo para desarrollo.
FLASK_DEBUG=0
